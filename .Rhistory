tkpack(view_frame,fill="both",expand=TRUE)
tkpack(tklabel(
view_frame,
text="View Notes",
font=font_sub,
bg="white"
))
# ---- Table Header ----
header_row <- tkframe(view_frame,bg="#F39F9F")
tkpack(header_row,fill="x")
headers <- c("TITLE","PRIORITY","DATE","KEYWORDS")
for(h in headers){
tkpack(tklabel(header_row,text=h,width=25,bg="#F39F9F",fg="white"),side="left")
}
# ---- Listbox ----
note_list <- tklistbox(
view_frame,
width=120,
height=15,
font=font_norm
)
tkpack(note_list,fill="both",expand=TRUE)
ids <- c()
refresh_list <- function(){
tkdelete(note_list,0,"end")
data <- dbGetQuery(con,"SELECT * FROM notes ORDER BY created_at DESC")
ids <<- data$id
for(i in 1:nrow(data)){
txt <- sprintf(
"%-25s %-10s %-12s %-30s",
substr(data$title[i],1,25),
data$priority[i],
data$created_at[i],
substr(data$keywords[i],1,30)
)
tkinsert(note_list,"end",txt)
tkitemconfigure(
note_list,
i-1,
foreground=priority_color(data$priority[i])
)
}
tkbind(note_list,"<<ListboxSelect>>",function(){
sel <- tkcurselection(note_list)
if(length(sel)==0) return()
note <- dbGetQuery(con,"SELECT * FROM notes WHERE id=?",params=list(ids[as.integer(sel)+1]))
selected_id <<- note$id
tclvalue(title_var) <- note$title
tclvalue(keyword_var) <- note$keywords
tclvalue(date_var) <- note$created_at
tkdelete(content_box,"1.0","end")
tkinsert(content_box,"end",note$content)
})
refresh_list()
# ===================== EXIT =====================
tkpack(
tkbutton(
root,text="Exit",
bg="#7f8c8d",fg="white",width=20,
command=function(){
dbDisconnect(con)
tkdestroy(root)
}
),
pady=10
)
tkwait.window(root)
# ===================== LIBRARIES =====================
library(tcltk)
library(DBI)
library(RSQLite)
# ===================== DATABASE =====================
DB_FILE <- "student_notes.db"
con <- dbConnect(SQLite(), DB_FILE)
dbExecute(con, "
CREATE TABLE IF NOT EXISTS notes (
id INTEGER PRIMARY KEY AUTOINCREMENT,
title TEXT,
content TEXT,
keywords TEXT,
priority TEXT,
created_at TEXT
)
")
# ===================== PRIORITY LOGIC =====================
high_kw <- c("exam","deadline","urgent","submission","test","review")
med_kw  <- c("project","quiz","activity","meeting","homework")
auto_priority <- function(text){
t <- tolower(text)
if(any(sapply(high_kw, grepl, t))) return("High")
if(any(sapply(med_kw, grepl, t)))  return("Medium")
"Low"
}
priority_color <- function(p){
if(p=="High") return("red")
if(p=="Medium") return("orange")
"darkgreen"
}
# ===================== HELPERS =====================
alert_sound <- function(){ tkbell() }
read_clip <- function(){
tryCatch(readClipboard(), error=function(e) "")
}
# ===================== CALENDAR PICKER =====================
open_calendar <- function(){
cal_win <- tktoplevel()
tkwm.title(cal_win,"Select Date")
cal_var <- tclVar(Sys.Date())
tkpack(tklabel(cal_win,text="Enter date (YYYY-MM-DD):"))
cal_entry <- tkentry(cal_win,textvariable=cal_var,width=20)
tkpack(cal_entry,pady=5)
tkpack(
tkbutton(cal_win,text="Select",
command=function(){
tclvalue(date_var) <- tclvalue(cal_var)
tkdestroy(cal_win)
}
)
}
# ===================== MAIN WINDOW =====================
root <- tktoplevel()
tkwm.title(root,"Notify – Student Note Organizer")
tkwm.geometry(root,"1050x720")
tkconfigure(root,bg="white")
font_title <- tkfont.create(family="Helvetica",size=20,weight="bold")
font_sub   <- tkfont.create(family="Helvetica",size=12,weight="bold")
font_norm  <- tkfont.create(family="Helvetica",size=11)
# ===================== HEADER =====================
header <- tkframe(root,bg="#B95E82",height=70)
tkpack(header,fill="x")
tkpack(
tklabel(header,text="Notify",font=font_title,fg="white",bg="#B95E82",pady=15)
)
# ===================== FORM =====================
form_box <- tkframe(root,bg="white",pady=10)
tkpack(form_box,fill="x")
tkpack(tklabel(form_box,text="Create / Update Note",font=font_sub,bg="white"))
form <- tkframe(form_box,bg="white")
tkpack(form)
title_var   <- tclVar("")
keyword_var <- tclVar("")
date_var    <- tclVar(Sys.Date())
selected_id <- NULL
# ---- Row 1 ----
tkgrid(tklabel(form,text="Title:",bg="white"),row=0,column=0,sticky="e",padx=5,pady=5)
tkgrid(tkentry(form,textvariable=title_var,width=35),row=0,column=1,padx=5)
tkgrid(tklabel(form,text="Date:",bg="white"),row=0,column=2,sticky="e",padx=5)
tkgrid(tkentry(form,textvariable=date_var,width=20),row=0,column=3,padx=5)
tkgrid(tkbutton(form,text="📅 Calendar",command=open_calendar),row=0,column=4,padx=5)
# ---- Row 2 ----
tkgrid(tklabel(form,text="Keywords:",bg="white"),row=1,column=0,sticky="e",padx=5)
tkgrid(tkentry(form,textvariable=keyword_var,width=35),row=1,column=1,padx=5)
# ---- Row 3 ----
tkgrid(tklabel(form,text="Description:",bg="white"),row=2,column=0,sticky="ne",padx=5)
content_box <- tktext(form,width=90,height=4,font=font_norm)
tkgrid(content_box,row=2,column=1,columnspan=4,pady=5)
# ---- Voice ----
tkgrid(
tkbutton(form,text="Voice Dictate",bg="#3498db",fg="white",
command=function(){
tclvalue(title_var) <- read_clip()
tkdelete(content_box,"1.0","end")
tkinsert(content_box,"end",read_clip())
}
),
row=3,column=1,sticky="w",pady=5
)
# ===================== CRUD =====================
btns <- tkframe(root,bg="white",pady=10)
tkpack(btns)
add_note <- function(){
title <- tclvalue(title_var)
content <- tkget(content_box,"1.0","end-1c")
kw <- tclvalue(keyword_var)
date <- tclvalue(date_var)
if(title=="" || content==""){
tkmessageBox(message="Title and Description required")
return()
}
pr <- auto_priority(paste(content,kw))
dbExecute(con,"
INSERT INTO notes(title,content,keywords,priority,created_at)
VALUES(?,?,?,?,?)
",params=list(title,content,kw,pr,date))
if(pr=="High") alert_sound()
clear_form()
refresh_list()
}
update_note <- function(){
if(is.null(selected_id)) return()
dbExecute(con,"
UPDATE notes SET title=?,content=?,keywords=?,priority=?,created_at=?
WHERE id=?
",params=list(
tclvalue(title_var),
tkget(content_box,"1.0","end-1c"),
tclvalue(keyword_var),
auto_priority(tkget(content_box,"1.0","end-1c")),
tclvalue(date_var),
selected_id
))
selected_id <<- NULL
clear_form()
refresh_list()
}
delete_note <- function(){
sel <- tkcurselection(note_list)
if(length(sel)==0) return()
id <- ids[as.integer(sel)+1]
dbExecute(con,"DELETE FROM notes WHERE id=?",params=list(id))
clear_form()
refresh_list()
}
clear_form <- function(){
tclvalue(title_var) <- ""
tclvalue(keyword_var) <- ""
tkdelete(content_box,"1.0","end")
}
tkgrid(
tkbutton(btns,text="Save",bg="#27ae60",fg="white",width=15,command=add_note),
tkbutton(btns,text="Update",bg="#f39c12",fg="white",width=15,command=update_note),
tkbutton(btns,text="Remove",bg="#e74c3c",fg="white",width=15,command=delete_note)
)
# ===================== VIEW NOTES =====================
view <- tkframe(root,bg="white",pady=10)
tkpack(view,fill="both",expand=TRUE)
tkpack(tklabel(view,text="View Notes",font=font_sub,bg="white"))
header_row <- tkframe(view,bg="#F39F9F")
tkpack(header_row,fill="x")
cols <- c("TITLE","DESCRIPTION","PRIORITY","DATE","KEYWORDS")
widths <- c(20,40,10,12,20)
for(i in 1:5){
tkpack(tklabel(header_row,text=cols[i],width=widths[i],
bg="#F39F9F",fg="white"),side="left")
}
note_list <- tklistbox(view,width=140,height=14,font=font_norm)
tkpack(note_list,fill="both",expand=TRUE)
ids <- c()
refresh_list <- function(){
tkdelete(note_list,0,"end")
data <- dbGetQuery(con,"SELECT * FROM notes ORDER BY created_at DESC")
ids <<- data$id
for(i in 1:nrow(data)){
row <- sprintf(
"%-20s %-40s %-10s %-12s %-20s",
substr(data$title[i],1,20),
substr(data$content[i],1,40),
data$priority[i],
data$created_at[i],
substr(data$keywords[i],1,20)
)
tkinsert(note_list,"end",row)
tkitemconfigure(note_list,i-1,foreground=priority_color(data$priority[i]))
}
tkbind(note_list,"<<ListboxSelect>>",function(){
sel <- tkcurselection(note_list)
if(length(sel)==0) return()
note <- dbGetQuery(con,"SELECT * FROM notes WHERE id=?",params=list(ids[as.integer(sel)+1]))
selected_id <<- note$id
tclvalue(title_var) <- note$title
tclvalue(keyword_var) <- note$keywords
tclvalue(date_var) <- note$created_at
tkdelete(content_box,"1.0","end")
tkinsert(content_box,"end",note$content)
})
refresh_list()
tkwait.window(root)
install.packages("tkcalendar")
# ===================== LIBRARIES =====================
library(tcltk)
library(DBI)
library(RSQLite)
# ===================== DATABASE =====================
DB_FILE <- "student_notes.db"
con <- dbConnect(SQLite(), DB_FILE)
dbExecute(con,"
CREATE TABLE IF NOT EXISTS notes (
id INTEGER PRIMARY KEY AUTOINCREMENT,
title TEXT,
content TEXT,
keywords TEXT,
priority TEXT,
created_at TEXT
)
")
# ===================== PRIORITY LOGIC =====================
high_kw <- c("exam","deadline","urgent","submission","test","review")
med_kw  <- c("project","quiz","activity","meeting","homework")
auto_priority <- function(text){
t <- tolower(text)
if(any(sapply(high_kw, grepl, t))) return("High")
if(any(sapply(med_kw, grepl, t)))  return("Medium")
"Low"
}
priority_color <- function(p){
if(p=="High") return("red")
if(p=="Medium") return("orange")
"darkgreen"
}
# ===================== DATE PICKER =====================
open_calendar <- function(){
win <- tktoplevel()
tkwm.title(win,"Select Date")
tkwm.geometry(win,"280x160")
y <- tclVar(format(Sys.Date(),"%Y"))
m <- tclVar(format(Sys.Date(),"%m"))
d <- tclVar(format(Sys.Date(),"%d"))
tkgrid(tklabel(win,text="Year"), row=0,column=0,padx=5,pady=5)
tkgrid(tkspinbox(win,from=2020,to=2035,textvariable=y,width=6),
row=0,column=1)
tkgrid(tklabel(win,text="Month"),row=1,column=0,padx=5)
tkgrid(tkspinbox(win,from=1,to=12,textvariable=m,width=6),
row=1,column=1)
tkgrid(tklabel(win,text="Day"),row=2,column=0,padx=5)
tkgrid(tkspinbox(win,from=1,to=31,textvariable=d,width=6),
row=2,column=1)
tkgrid(
tkbutton(win,text="Set Date",
command=function(){
tclvalue(date_var) <<- sprintf(
"%04d-%02d-%02d",
as.integer(tclvalue(y)),
as.integer(tclvalue(m)),
as.integer(tclvalue(d))
)
tkdestroy(win)
}
),
row=3,columnspan=2,pady=10
)
}
# ===================== MAIN WINDOW =====================
root <- tktoplevel()
tkwm.title(root,"Notify – Student Note Organizer")
tkwm.geometry(root,"1100x750")
tkconfigure(root,bg="white")
font_title <- tkfont.create(family="Helvetica",size=20,weight="bold")
font_sub   <- tkfont.create(family="Helvetica",size=12,weight="bold")
font_norm  <- tkfont.create(family="Helvetica",size=11)
# ===================== HEADER =====================
header <- tkframe(root,bg="#B95E82",height=70)
tkpack(header,fill="x")
tkpack(
tklabel(header,text="Notify",font=font_title,fg="white",bg="#B95E82",pady=15)
)
# ===================== FORM =====================
form_box <- tkframe(root,bg="white",pady=10)
tkpack(form_box,fill="x")
tkpack(tklabel(form_box,text="Create / Update Note",font=font_sub,bg="white"))
form <- tkframe(form_box,bg="white")
tkpack(form)
title_var   <- tclVar("")
keyword_var <- tclVar("")
date_var    <- tclVar(Sys.Date())
selected_id <- NULL
tkgrid(tklabel(form,text="Title:",bg="white"),row=0,column=0,sticky="e")
tkgrid(tkentry(form,textvariable=title_var,width=35),row=0,column=1,padx=5)
tkgrid(tklabel(form,text="Date:",bg="white"),row=0,column=2,sticky="e")
tkgrid(tkentry(form,textvariable=date_var,width=15,state="readonly"),
row=0,column=3)
tkgrid(tkbutton(form,text="Calendar",command=open_calendar),
row=0,column=4,padx=5)
tkgrid(tklabel(form,text="Keywords:",bg="white"),row=1,column=0,sticky="e")
tkgrid(tkentry(form,textvariable=keyword_var,width=35),
row=1,column=1,padx=5)
tkgrid(tklabel(form,text="Description:",bg="white"),
row=2,column=0,sticky="ne")
content_box <- tktext(form,width=90,height=4,font=font_norm)
tkgrid(content_box,row=2,column=1,columnspan=4,pady=5)
# ===================== CRUD =====================
btns <- tkframe(root,bg="white",pady=10)
tkpack(btns)
add_note <- function(){
title <- tclvalue(title_var)
content <- tkget(content_box,"1.0","end-1c")
kw <- tclvalue(keyword_var)
date <- tclvalue(date_var)
if(title=="" || content=="") return()
pr <- auto_priority(paste(content,kw))
dbExecute(con,"
INSERT INTO notes(title,content,keywords,priority,created_at)
VALUES(?,?,?,?,?)
",params=list(title,content,kw,pr,date))
clear_form()
refresh_list()
}
update_note <- function(){
if(is.null(selected_id)) return()
dbExecute(con,"
UPDATE notes SET title=?,content=?,keywords=?,priority=?,created_at=?
WHERE id=?
",params=list(
tclvalue(title_var),
tkget(content_box,"1.0","end-1c"),
tclvalue(keyword_var),
auto_priority(tkget(content_box,"1.0","end-1c")),
tclvalue(date_var),
selected_id
))
selected_id <<- NULL
clear_form()
refresh_list()
}
delete_note <- function(){
sel <- tkcurselection(note_list)
if(length(sel)==0) return()
id <- ids[as.integer(sel)+1]
dbExecute(con,"DELETE FROM notes WHERE id=?",params=list(id))
clear_form()
refresh_list()
}
clear_form <- function(){
tclvalue(title_var) <- ""
tclvalue(keyword_var) <- ""
tkdelete(content_box,"1.0","end")
}
tkgrid(
tkbutton(btns,text="Save",bg="#27ae60",fg="white",width=15,command=add_note),
tkbutton(btns,text="Update",bg="#f39c12",fg="white",width=15,command=update_note),
tkbutton(btns,text="Remove",bg="#e74c3c",fg="white",width=15,command=delete_note)
)
# ===================== VIEW NOTES =====================
view <- tkframe(root,bg="white",pady=10)
tkpack(view,fill="both",expand=TRUE)
tkpack(tklabel(view,text="View Notes",font=font_sub,bg="white"))
note_list <- tklistbox(view,width=150,height=16,font=font_norm)
tkpack(note_list,fill="both",expand=TRUE,padx=10)
ids <- c()
refresh_list <- function(){
tkdelete(note_list,0,"end")
data <- dbGetQuery(con,"SELECT * FROM notes ORDER BY created_at DESC")
ids <<- data$id
for(i in 1:nrow(data)){
row <- paste(
data$title[i],"|",
substr(data$content[i],1,40),"|",
data$priority[i],"|",
data$created_at[i]
)
tkinsert(note_list,"end",row)
tkitemconfigure(note_list,i-1,foreground=priority_color(data$priority[i]))
}
tkbind(note_list,"<<ListboxSelect>>",function(){
sel <- tkcurselection(note_list)
if(length(sel)==0) return()
note <- dbGetQuery(con,"SELECT * FROM notes WHERE id=?",params=list(ids[as.integer(sel)+1]))
selected_id <<- note$id
tclvalue(title_var) <- note$title
tclvalue(keyword_var) <- note$keywords
tclvalue(date_var) <- note$created_at
tkdelete(content_box,"1.0","end")
tkinsert(content_box,"end",note$content)
})
refresh_list()
